# ==============================================================================
# REHAT-PW ROOT SECURITY & REWRITE CONFIGURATION
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct access to sensitive system files and directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|artisan|phpunit\.xml|README\.md|storage/logs/.*|database/.*) - [F,L]

    # 2. Redirect all public web traffic to the /public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable Directory Browsing
Options -Indexes

# Block access to hidden files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to sensitive file extensions
<FilesMatch "(?i)\.(env|json|lock|yml|yaml|sql|sqlite|db|log|ini|sh|bak|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
